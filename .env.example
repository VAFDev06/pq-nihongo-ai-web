# ==============================================================
# PQ NIHONGO (NIHONGO AI) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your own secure credentials
# IMPORTANT: Generate your own JWT secret & strong admin password
# before running the application. Never commit .env to Git.
# ==============================================================

# 1. Server & Profile Configuration
SERVER_PORT=8080
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=dev

# 2. Database Configuration (PostgreSQL 15/16)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nihongoai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# 3. JWT Security Configuration (Minimum 256-bit random secret key)
# Generate a random secret before deployment (e.g. openssl rand -hex 32)
APP_JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# 4. Default Admin Bootstrap Credentials
# Change to a strong password before first startup
ADMIN_EMAIL=admin@nihongoai.local
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# 5. Google Gemini AI Configuration
# Get an API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3-flash-preview

# 6. File Upload Storage Directory
APP_STORAGE_LOCAL_DIR=./uploads
