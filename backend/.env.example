# Backend Environment Variables (Optional - defaults are already set in application.yml)
# IMPORTANT: Never commit real secrets. Copy root .env.example to .env and set your own credentials.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nihongoai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3-flash-preview
APP_JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET
ADMIN_EMAIL=admin@nihongoai.local
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
APP_STORAGE_LOCAL_DIR=./uploads
