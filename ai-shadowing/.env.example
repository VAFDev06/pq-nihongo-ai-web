# PQ Nihongo Private Shadowing AI Model Server
# Copy to .env and customize for your deployment environment.
# No Gemini API keys are needed or used in Shadowing.

SHADOWING_HOST=127.0.0.1
SHADOWING_PORT=8001
SHADOWING_WORKERS=1
LOG_LEVEL=INFO

# Pretrained Models
SHADOWING_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
SHADOWING_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
SHADOWING_ASR_ENABLED=true
SHADOWING_ALIGNER_ENABLED=true
SHADOWING_PRONUNCIATION_ENABLED=true
SHADOWING_INTONATION_ENABLED=true

# Optional Local Feedback LLM (disabled by default; deterministic Vietnamese templates used otherwise)
SHADOWING_FEEDBACK_MODEL_ENABLED=false
SHADOWING_FEEDBACK_MODEL=Qwen/Qwen3-4B

# Device & Memory Management
# auto: uses cuda:0 if available else cpu
# low_vram_mode=auto: automatically offloads models sequentially on GPUs with <= 6GB VRAM
SHADOWING_DEVICE=auto
SHADOWING_LOW_VRAM_MODE=auto
SHADOWING_PRELOAD_MODELS=false
SHADOWING_TIMEOUT_SECONDS=120

# Model Storage Paths (defaults to ./ai-shadowing/.cache/...)
# HF_HOME=./.cache/huggingface
# HATSUON_MODEL_DIR=./.cache/hatsuon

# Audio Limits
SHADOWING_MAX_FILE_SIZE_MB=15
SHADOWING_MIN_AUDIO_SECONDS=0.35
SHADOWING_MAX_AUDIO_SECONDS=35
SHADOWING_TARGET_SAMPLE_RATE=16000
